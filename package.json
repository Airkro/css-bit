{
  "private": true,
  "name": "css-bit-dev",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Eric Chen",
    "email": "airkro@qq.com"
  },
  "homepage": "https://github.com/airkro/css-bit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airkro/css-bit.git"
  },
  "bugs": {
    "url": "https://github.com/airkro/css-bit/issues"
  },
  "type": "module",
  "scripts": {
    "fmt:prettier": "prettier -w .",
    "generate": "node config/generate.mjs",
    "lint:eslint": "eslint . --quiet --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "lint:version": "syncpack lint",
    "prepare": "nice-move git hooks",
    "snapshot": "ava --fail-fast -u",
    "test": "ava --fail-fast",
    "version:pin": "syncpack fix"
  },
  "devDependencies": {
    "@ant-design/colors": "^8.0.1",
    "@bring-it/npm": "^0.9.6",
    "@nice-move/all-in-base": "^0.9.0",
    "@nice-move/syncpack-config": "^0.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "ava": "^8.0.1",
    "eslint": "^10.9.1",
    "fs-chain": "^8.2.4",
    "garou": "^0.9.21",
    "postcss": "^8.5.26",
    "prettier": "~3.9.6",
    "syncpack": "^15.3.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@css-bit/tailwind-antd-color": "workspace:^",
    "@css-bit/tailwind-smart-config": "workspace:^"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^10.34.5"
  },
  "ava": {
    "extensions": [
      "mts"
    ]
  },
  "prettier": "@nice-move/all-in-base/prettier"
}
